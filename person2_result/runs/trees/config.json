{
  "arguments": {
    "models": [
      "decision_tree",
      "random_forest",
      "adaboost"
    ],
    "stage": "full",
    "drop": [],
    "seeds": [
      11,
      23,
      42
    ],
    "smoke": false,
    "refit": false,
    "jobs": 4,
    "params": "{}",
    "train_limit": 0,
    "out": "runs/trees",
    "data_dir": "/content/final_csv",
    "events": "/content/fresh_2025/output_with_weather.parquet"
  },
  "features": [
    "month",
    "dow",
    "dep_hour",
    "arr_hour",
    "CRSElapsedTime",
    "Distance",
    "is_holiday",
    "Origin",
    "Dest",
    "Reporting_Airline",
    "wx_skyc1_T2h",
    "wx_tmpf_T2h",
    "wx_dwpf_T2h",
    "wx_drct_T2h",
    "wx_sknt_T2h",
    "wx_gust_T2h",
    "wx_vsby_T2h",
    "wx_p01i_T2h",
    "wx_skyl1_T2h",
    "wx_obs_age_min_T2h",
    "wx_ts_T2h",
    "wx_fg_T2h",
    "wx_ra_T2h",
    "wx_sn_T2h",
    "wx_fz_T2h",
    "wx_br_hz_T2h",
    "wx_gust_missing_T2h",
    "wx_skyl1_missing_T2h",
    "codes_known_T2h",
    "wx_unmatched_T2h",
    "n_departed_60min_T2h",
    "prior_mean_delay_60min_T2h",
    "late_rate_60min_T2h",
    "n_scheduled_next_60min_T2h",
    "has_history_T2h"
  ],
  "defaults": {
    "constant": {},
    "decision_tree": {
      "max_depth": 12,
      "min_samples_leaf": 50,
      "ccp_alpha": 1e-05
    },
    "random_forest": {
      "n_estimators": 100,
      "max_depth": 16,
      "min_samples_leaf": 12
    },
    "logreg": {
      "C": 1.0
    },
    "pca_logreg": {
      "C": 1.0
    },
    "adaboost": {
      "max_depth": 2,
      "n_estimators": 60,
      "learning_rate": 0.1
    },
    "gradient": {
      "n_estimators": 80,
      "max_depth": 3,
      "learning_rate": 0.08
    },
    "histgb": {
      "max_iter": 120,
      "max_leaf_nodes": 31
    },
    "xgboost": {
      "n_estimators": 150,
      "max_depth": 6,
      "subsample": 0.85
    },
    "lightgbm": {
      "n_estimators": 150,
      "num_leaves": 31,
      "subsample": 0.85,
      "subsample_freq": 1
    },
    "catboost": {
      "iterations": 150,
      "depth": 6
    }
  }
}